# ============================================================
# StockAI Polymers - Offline Factory Environment
# ============================================================
#
# Copy this file to:
#
#   deployment/offline/.env
#
# Then replace EVERY placeholder containing CHANGE_ME.
#
# NEVER commit the real .env file.
# NEVER place production secrets in GitHub.
# ============================================================

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
DB_NAME=stockai
DB_USERNAME=stockai
DB_PASSWORD=CHANGE_ME_WITH_A_UNIQUE_STRONG_DATABASE_PASSWORD

DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_WITH_A_UNIQUE_STRONG_REDIS_PASSWORD

# ------------------------------------------------------------
# JWT signing key
# Use a cryptographically random value of at least 32 bytes.
# ------------------------------------------------------------
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_256_BIT_OR_STRONGER_SECRET
JWT_EXPIRATION_MS=3600000

# ------------------------------------------------------------
# IoT device authentication
# Generate unique high-entropy values.
# ------------------------------------------------------------
IOT_DEVICE_SALT=CHANGE_ME_WITH_A_RANDOM_DEVICE_SALT
IOT_DEVICE_KEY=CHANGE_ME_WITH_A_RANDOM_DEVICE_KEY

# ------------------------------------------------------------
# Authentication policy
# ------------------------------------------------------------
# true = privileged accounts require TOTP MFA.
MFA_ENFORCED=false

# ------------------------------------------------------------
# Factory browser origin
# For local testing use localhost.
# For LAN deployment add the factory server address, for example:
# http://192.168.1.50:8081
# ------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# ------------------------------------------------------------
# Kafka is intentionally disabled in the offline base stack.
# ------------------------------------------------------------
KAFKA_ENABLED=false

