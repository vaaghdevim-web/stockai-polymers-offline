            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.environment.get('admin_password')) {",
                  "    pm.environment.set('admin_password', 'admin123');",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response includes valid JWT access and refresh tokens', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(data.refreshToken).to.be.a('string').and.not.empty;",
                  "    pm.environment.set('jwt_token', data.token);",
