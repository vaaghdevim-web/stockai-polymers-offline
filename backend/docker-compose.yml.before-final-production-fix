version: '3.8'

services:
  # ==============================================================================
  # 1. Edge Reverse Proxy & Ingress Gateway (Publicly Accessible)
  # ==============================================================================
  nginx-gateway:
    image: nginx:1.25-alpine
    container_name: stockai-nginx-gateway
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
    depends_on:
      stockai-app:
        condition: service_healthy
    networks:
      - frontend-network

  # ==============================================================================
  # 2. Main Application Service (Spring Boot 4.x / JDK 23)
  # ==============================================================================
  stockai-app:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: stockai-backend
    restart: unless-stopped
    ports:
      # Bound strictly to loopback to prevent direct bypass of Nginx reverse proxy
      - "127.0.0.1:8080:8080"
    environment:
      - SPRING_PROFILES_ACTIVE=${SPRING_PROFILES_ACTIVE:-local}
      - DB_HOST=postgres
      - DB_PORT=5432
      - DB_NAME=${DB_NAME:-stockai}
      - DB_USERNAME=${DB_USERNAME:-postgres}
      - DB_PASSWORD=${DB_PASSWORD:?DB_PASSWORD environment variable must be specified}
      - DB_POOL_MAX_SIZE=${DB_POOL_MAX_SIZE:-20}
      - DB_POOL_MIN_IDLE=${DB_POOL_MIN_IDLE:-5}
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - REDIS_PASSWORD=${REDIS_PASSWORD:?REDIS_PASSWORD environment variable must be specified}
      - KAFKA_ENABLED=${KAFKA_ENABLED:-true}
      - KAFKA_BOOTSTRAP_SERVERS=kafka:29092
      - STORAGE_BASE_PATH=/app/storage
      - S3_BUCKET_NAME=${S3_BUCKET_NAME:-stockai-documents}
      - JWT_SECRET=${JWT_SECRET:?JWT_SECRET environment variable must be specified}
      - CORS_ALLOWED_ORIGINS=${CORS_ALLOWED_ORIGINS:-http://localhost:3000,http://localhost:5173,https://stockai.svpgroup.com}
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      kafka:
        condition: service_started
      minio:
        condition: service_started
    volumes:
      - app-storage:/app/storage
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:8080/actuator/health | grep -q 'UP' || exit 1"]
      interval: 30s
      timeout: 5s
      start_period: 60s
      retries: 3
    networks:
      - frontend-network
      - backend-network

  # ==============================================================================
  # 3. Operational Relational Database (PostgreSQL 16 - Isolated)
  # ==============================================================================
  postgres:
    image: postgres:16-alpine
    container_name: stockai-postgres
    restart: unless-stopped
    ports:
      - "127.0.0.1:5432:5432"
    environment:
      - POSTGRES_DB=${DB_NAME:-stockai}
      - POSTGRES_USER=${DB_USERNAME:-postgres}
      - POSTGRES_PASSWORD=${DB_PASSWORD:?DB_PASSWORD environment variable must be specified}
    volumes:
      - postgres-data:/var/lib/postgresql/data
      - ./src/main/resources/db/schema_v2.4.sql:/docker-entrypoint-initdb.d/01_schema_v2.4.sql:ro
      - ./src/main/resources/db/seed_factory_master_data.sql:/docker-entrypoint-initdb.d/02_seed_factory_master_data.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USERNAME:-postgres} -d ${DB_NAME:-stockai}"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - backend-network

  # ==============================================================================
  # 4. In-Memory Cache & Token Blacklist (Redis 7.2 - Authenticated & Isolated)
  # ==============================================================================
  redis:
    image: redis:7.2-alpine
    container_name: stockai-redis
    restart: unless-stopped
    command: ["sh", "-c", "redis-server --requirepass ${REDIS_PASSWORD:?REDIS_PASSWORD required}"]
    ports:
      - "127.0.0.1:6379:6379"
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD:?REDIS_PASSWORD required}", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - backend-network

  # ==============================================================================
  # 5. Apache Kafka & Zookeeper (Event Streaming Layer - Isolated)
  # ==============================================================================
  zookeeper:
    image: confluentinc/cp-zookeeper:7.5.0
    container_name: stockai-zookeeper
    restart: unless-stopped
    environment:
      ZOOKEEPER_CLIENT_PORT: 2181
      ZOOKEEPER_TICK_TIME: 2000
    networks:
      - backend-network

  kafka:
    image: confluentinc/cp-kafka:7.5.0
    container_name: stockai-kafka
    restart: unless-stopped
    ports:
      - "127.0.0.1:9092:9092"
    environment:
      KAFKA_BROKER_ID: 1
      KAFKA_ZOOKEEPER_CONNECT: zookeeper:2181
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: PLAINTEXT:PLAINTEXT,PLAINTEXT_INTERNAL:PLAINTEXT
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://127.0.0.1:9092,PLAINTEXT_INTERNAL://kafka:29092
      KAFKA_LISTENERS: PLAINTEXT://0.0.0.0:9092,PLAINTEXT_INTERNAL://0.0.0.0:29092
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
    depends_on:
      - zookeeper
    networks:
      - backend-network

  # ==============================================================================
  # 6. S3-Compatible Document Storage (MinIO - Isolated)
  # ==============================================================================
  minio:
    image: quay.io/minio/minio:latest
    container_name: stockai-minio
    restart: unless-stopped
    ports:
      - "127.0.0.1:9000:9000"
      - "127.0.0.1:9001:9001"
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:-stockai-admin}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:-stockai-admin-password-2026}
    command: server /data --console-address ":9001"
    volumes:
      - minio-data:/data
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:9000/minio/health/live || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - backend-network

networks:
  frontend-network:
    driver: bridge
  backend-network:
    driver: bridge

volumes:
  postgres-data:
  redis-data:
  minio-data:
  app-storage:
