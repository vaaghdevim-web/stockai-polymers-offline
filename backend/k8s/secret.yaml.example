apiVersion: v1
kind: Secret
metadata:
  name: stockai-secrets
  namespace: stockai-prod
  labels:
    app.kubernetes.io/name: stockai
    environment: production
type: Opaque
stringData:
  # Base64 encoded or stringData injected via HashiCorp Vault / AWS Secrets Manager / SealedSecrets
  DB_PASSWORD: "REPLACE_WITH_STRONG_PRODUCTION_DB_PASSWORD"
  JWT_SECRET: "REPLACE_WITH_256_BIT_CRYPTOGRAPHIC_JWT_SECRET_AT_LEAST_32_CHARS"
  REDIS_PASSWORD: "REPLACE_WITH_STRONG_REDIS_PASSWORD"
  MINIO_ROOT_USER: "REPLACE_WITH_MINIO_ROOT_USER"
  MINIO_ROOT_PASSWORD: "REPLACE_WITH_STRONG_MINIO_SECRET_KEY"
