# ==============================================================================
# StockAI Environment Configuration Template (.env.example)
# Copy this file to .env and populate with secure, high-entropy secrets.
# NEVER COMMIT THE ACTUAL .env FILE TO GIT!
# ==============================================================================

# Spring Active Profile (local, test, or prod)
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Relational Database Credentials
DB_NAME=stockai
DB_USERNAME=postgres
DB_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD_HERE
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# Redis In-Memory Cache & Token Revocation Store Password
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD_HERE

# HMAC-SHA256 JWT Secret (Minimum 32 characters / 256 bits)
JWT_SECRET=YOUR_MINIMUM_32_CHAR_CRYPTOGRAPHIC_JWT_SECRET_HERE

# MinIO / Private S3 Object Store Credentials
MINIO_ROOT_USER=stockai-admin
MINIO_ROOT_PASSWORD=YOUR_STRONG_MINIO_PASSWORD_HERE
S3_BUCKET_NAME=stockai-documents

# Apache Kafka Event Streaming Configuration
KAFKA_ENABLED=true

# Multi-Factor Authentication (MFA) Global Enforcement Policy
MFA_ENFORCED=true

# IoT Device Registry Secret Salt for Key Hashing
IOT_DEVICE_SALT=YOUR_PER_DEVICE_SECRET_SALT_HERE

# CORS Whitelist Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://stockai.svpgroup.com
